<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. The main keyboard icon, explicitly sized to be the base layer -->
    <item
        android:drawable="@drawable/ic_baseline_keyboard_24"
        android:width="48dp"
        android:height="48dp"
        android:gravity="center"
        />

    <!-- 2. A circular background for the gear -->
    <item
        android:width="28dp"
        android:height="28dp"
        android:gravity="bottom|right"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/white" />
            <stroke android:width="1dp" android:color="@android:color/darker_gray"/>
        </shape>
    </item>

    <!-- 3. The gear icon on top of the circle -->
    <item
        android:width="20dp"
        android:height="20dp"
        android:drawable="@drawable/ic_baseline_build_24"
        android:gravity="bottom|right"
        android:bottom="6dp"
        android:right="6dp"/>
</layer-list>
